<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Header: Logo/Label & Quick Add Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_small_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Cassiel"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#2D5284" />

        <!-- 1-Tap Quick Action (+) -->
        <ImageButton
            android:id="@+id/btn_small_quick_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_btn_circle"
            android:src="@drawable/ic_stat_icon"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Tambah Transaksi" />
    </RelativeLayout>

    <!-- Center Content: Sisa Jatah Hari Ini & Validasi Mood -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_small_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jatah Hari Ini"
            android:textSize="11sp"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/tv_small_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 85.000"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <!-- Status Mood Badge -->
        <TextView
            android:id="@+id/tv_small_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terkendali ✨"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#58B07A"
            android:layout_marginTop="3dp" />
    </LinearLayout>

</LinearLayout>
