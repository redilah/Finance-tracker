<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/widget_background_dark">

    <!-- Bagian Atas: Header Row (Label 'Hari Ini' di kiri + Tombol Refresh di kanan atas) -->
    <RelativeLayout
        android:id="@+id/layout_small_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">

        <TextView
            android:id="@+id/tv_small_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Hari Ini"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#9CA3AF"
            android:fontFamily="sans-serif-medium" />

        <!-- Tombol Refresh di Pojok Kanan Atas (Persis seperti Screen Time) -->
        <ImageButton
            android:id="@+id/btn_small_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_widget_refresh"
            android:tint="#9CA3AF"
            android:scaleType="centerInside"
            android:padding="3dp"
            android:contentDescription="Perbarui Data Widget" />
    </RelativeLayout>

    <!-- Nominal Pengeluaran Hari Ini (Besar & Tebal di bawah Header) -->
    <TextView
        android:id="@+id/tv_small_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_small_header"
        android:layout_alignParentStart="true"
        android:text="Rp 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginTop="2dp" />

    <!-- Tombol Bulat Logo CF (Quick Access Assistant) di Pojok Kanan Bawah -->
    <ImageButton
        android:id="@+id/btn_small_cf_assistant"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_btn_circle"
        android:src="@drawable/ic_stat_icon"
        android:tint="#FFFFFF"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="Cassiel Quick Assistant" />

</RelativeLayout>
