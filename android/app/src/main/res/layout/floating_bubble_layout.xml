<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_bubble_root"
    android:layout_width="54dp"
    android:layout_height="54dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Pure CF Silhouette with subtle drop shadow - Zero Background Box -->
    <ImageView
        android:id="@+id/bubble_cf_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_stat_icon"
        android:scaleType="fitCenter"
        android:contentDescription="Cassiel Quick Assist" />

</FrameLayout>
