rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cloud Backup Pengguna Terautentikasi (OWASP MASVS-AUTH-1 & MASVS-STORAGE-1)
    // Hanya pemilik akun (UID cocok) yang diizinkan membaca dan menulis cadangan datanya sendiri
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Telemetri Cassiel Command: Validasi skema & integritas ID dokumen, tolak penghapusan publik
    match /cassiel_telemetry/{document} {
      allow create, update: if request.resource.data.id is string
                            && request.resource.data.id == document
                            && request.resource.data.id.size() >= 4
                            && request.resource.data.id.size() <= 128;
      allow read: if true;
      allow delete: if false;
    }

    // Feedback & Laporan Pengguna
    match /cassiel_feedback/{document} {
      allow create, update: if request.resource.data.id is string
                            && request.resource.data.id == document;
      allow read: if true;
      allow delete: if false;
    }

    // Transparansi Donasi Kitabisa
    match /cassiel_kitabisa_transparency/{document} {
      allow read: if true;
      allow create, update: if request.resource.data is map;
      allow delete: if false;
    }

    // Articles & Research Papers (Read-only publik)
    match /articles/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /research_papers/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Cassiel Shared Groups (Sinkronisasi kas & chat grup lintas perangkat via kode undangan)
    // Dilarang menghapus dokumen grup secara sepihak tanpa otorisasi (anti-sabotase)
    match /cassiel_shared_groups/{groupId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
                            && request.resource.data.id == groupId
                            && request.resource.data.inviteCode is string
                            && request.resource.data.inviteCode.size() >= 3
                            && request.resource.data.inviteCode.size() <= 16;
      allow delete: if false;
    }

    // Default Deny untuk semua koleksi/dokumen lainnya
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
