rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Telemetri Cassiel Command: Izinkan create & update dengan validasi integritas ID dokumen
    match /cassiel_telemetry/{document} {
      allow create, update: if request.resource.data.id is string
                            && request.resource.data.id == document;
      allow read: if true;
      allow delete: if false;
    }

    // Articles & Research Papers (Read-only publik)
    match /articles/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /research_papers/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Default Deny untuk semua koleksi/dokumen lainnya
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
