rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{document} {
      allow read, write: if true;
    }
    match /research_papers/{document} {
      allow read, write: if true;
    }
    match /puncak_telemetry/{document} {
      allow read, write: if true;
    }
    match /cassiel_telemetry/{document} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
